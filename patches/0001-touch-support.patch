From d0c316ee421c44ea02c8b9ba868ef0016232c712 Mon Sep 17 00:00:00 2001
From: Ken Blizzard-Caron <ken@blizzardcaron.com>
Date: Wed, 21 Oct 2026 23:06:46 -0600
Subject: [PATCH] Support touch on the emulator buttons; document Espruino's
 lack of hoisting

Mobile Safari only synthesizes mouse events after a touch ends, so holds
and two-finger A+L presses were impossible on phones and tablets. A shared
bindPressRelease() adds touch listeners to all five buttons, and the
buttons no longer start text selection on a long press.

Espruino doesn't hoist function declarations, and the emulator's browser
engine does, so top-level calls to later functions pass in the emulator
but fail on the watch. AGENTS.md and the architecture doc now say so.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 js/app.js | 24 +++++++++++++++---------
 style.css |  5 +++++
 2 files changed, 20 insertions(+), 9 deletions(-)

diff --git a/js/app.js b/js/app.js
index ef9702e..40b2398 100644
--- a/js/app.js
+++ b/js/app.js
@@ -538,6 +538,18 @@ function millisNow() {
 // on-screen button stuck lit.
 // The HOLD icon lights once the hold period elapses whether or not the
 // script subscribes to *_long - it shows the physical hold registering.
+// Mouse and touch both drive press/release. Mobile Safari only synthesizes mouse
+// events after a touch ends, so without the touch listeners a hold or a
+// two-finger A+L press can't happen on a phone or tablet.
+function bindPressRelease(el, press, release) {
+  el.addEventListener('mousedown', press);
+  el.addEventListener('mouseup', release);
+  el.addEventListener('mouseleave', release);
+  el.addEventListener('touchstart', (e) => { e.preventDefault(); press(); }, { passive: false });
+  el.addEventListener('touchend', (e) => { e.preventDefault(); release(); }, { passive: false });
+  el.addEventListener('touchcancel', release);
+}
+
 function createHoldableButton({ el, holdMs, shortBit, shortHook, longBit, longHook, btnConst, setVisual, setHold }) {
   let holdTimer = null;
   let held = false;
@@ -562,9 +574,7 @@ function createHoldableButton({ el, holdMs, shortBit, shortHook, longBit, longHo
     setHold(false);
     if (running && (effectiveSubs & E_BUTTONS)) runHook(hooks.button, 'button', btnConst, E_UP, millisNow());
   }
-  el.addEventListener('mousedown', press);
-  el.addEventListener('mouseup', release);
-  el.addEventListener('mouseleave', release);
+  bindPressRelease(el, press, release);
   return { press, release };
 }
 
@@ -623,9 +633,7 @@ function createModeButton(el, setVisual, setHold) {
     if (holdTimer) { clearTimeout(holdTimer); holdTimer = null; }
     setHold(false);
   }
-  el.addEventListener('mousedown', press);
-  el.addEventListener('mouseup', release);
-  el.addEventListener('mouseleave', release);
+  bindPressRelease(el, press, release);
   return { press, release };
 }
 
@@ -652,9 +660,7 @@ function createMomentaryButton({ el, bit, hook, setVisual }) {
     held = false;
     setVisual(false);
   }
-  el.addEventListener('mousedown', press);
-  el.addEventListener('mouseup', release);
-  el.addEventListener('mouseleave', release);
+  bindPressRelease(el, press, release);
   return { press, release };
 }
 
diff --git a/style.css b/style.css
index 2a11906..effaea1 100644
--- a/style.css
+++ b/style.css
@@ -121,6 +121,11 @@ h1 { margin: 0 0 4px; font-size: 20px; }
   font-size: 16px;
   font-weight: 600;
   cursor: pointer;
+  /* Holding a button on touch screens must not select text or open a callout. */
+  -webkit-user-select: none;
+  user-select: none;
+  -webkit-touch-callout: none;
+  touch-action: none;
 }
 .phys-btn:active { background: #3d4250; }
 .phys-btn:disabled { opacity: 0.4; cursor: default; }
