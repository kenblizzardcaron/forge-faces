From 86dac67c3cff90a3b324617e852db96d356c89fd Mon Sep 17 00:00:00 2001
From: Ken Blizzard-Caron <ken@blizzardcaron.com>
Date: Thu, 22 Oct 2026 22:37:18 -0600
Subject: [PATCH] Preload a face from the URL: ?face=<name> loads
 faces/<name>.js

Its prebuilt faces/<name>.min.js goes in the minified tab untouched; the in-page
minifier never renames, so regenerating it would undo the build. Names are
limited to [A-Za-z0-9_-]; an unknown face logs the error and loads the template.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 js/app.js | 34 +++++++++++++++++++++++++++-------
 1 file changed, 27 insertions(+), 7 deletions(-)

diff --git a/js/app.js b/js/app.js
index 61bd17b..38ad568 100644
--- a/js/app.js
+++ b/js/app.js
@@ -333,21 +333,41 @@ function a_short() {
 }
 `;
 
-function loadDefaultExample(text) {
+function loadDefaultExample(text, name = DEFAULT_EXAMPLE) {
   editor.value = text;
-  filenameInput.value = DEFAULT_EXAMPLE;
+  filenameInput.value = name;
   updateTabLabels();
   updateSizeMeter();
   warnIfOverByteLimit(text, FORGE_SCRIPT_BYTE_LIMIT_WARNING);
 }
 
-fetch(`examples/${DEFAULT_EXAMPLE}`)
-  .then((res) => {
+function fetchText(path) {
+  return fetch(path).then((res) => {
     if (!res.ok) throw new Error(`HTTP ${res.status}`);
     return res.text();
-  })
-  .then(loadDefaultExample)
-  .catch(() => loadDefaultExample(DEFAULT_EXAMPLE_FALLBACK));
+  });
+}
+
+function loadTemplate() {
+  fetchText(`examples/${DEFAULT_EXAMPLE}`)
+    .then((text) => loadDefaultExample(text))
+    .catch(() => loadDefaultExample(DEFAULT_EXAMPLE_FALLBACK));
+}
+
+// ?face=<name> preloads faces/<name>.js and puts its prebuilt faces/<name>.min.js in the
+// minified tab as-is: the in-page minifier never renames, so regenerating it would undo the build.
+const faceParam = new URLSearchParams(location.search).get('face');
+if (faceParam && /^[\w-]+$/.test(faceParam)) {
+  Promise.all([fetchText(`faces/${faceParam}.js`), fetchText(`faces/${faceParam}.min.js`)])
+    .then(([source, built]) => {
+      loadDefaultExample(source, `${faceParam}.js`);
+      editorMinified.value = built;
+      minifiedSourceSnapshot = source;
+    })
+    .catch((e) => { logError(`Couldn't load face "${faceParam}": ${e.message}`); loadTemplate(); });
+} else {
+  loadTemplate();
+}
 
 function setStatus(text, cls) {
   statusEl.textContent = text;
-- 
