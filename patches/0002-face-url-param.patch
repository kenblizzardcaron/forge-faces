From bb5c1045767f95e48aa695a0043ec0f1b9e46ec0 Mon Sep 17 00:00:00 2001
From: Ken Blizzard-Caron <ken@blizzardcaron.com>
Date: Mon, 16 Nov 2026 21:15:08 -0700
Subject: [PATCH] Preload a face from the URL: ?face=<name> loads
 faces/<name>.js

Its prebuilt faces/<name>.min.js goes in the minified tab untouched; the in-page
minifier never renames, so regenerating it would undo the build. Names are
limited to [A-Za-z0-9_-]; an unknown face logs the error and loads the template.
The load replaces defaultExampleReady, so review mode still waits for it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 js/app.js | 23 ++++++++++++++++++++++-
 1 file changed, 22 insertions(+), 1 deletion(-)

diff --git a/js/app.js b/js/app.js
index 4369413..497ee4a 100644
--- a/js/app.js
+++ b/js/app.js
@@ -353,7 +353,28 @@ function loadDefaultExampleScript() {
     .then(loadDefaultExample)
     .catch(() => loadDefaultExample(DEFAULT_EXAMPLE_FALLBACK));
 }
-const defaultExampleReady = loadDefaultExampleScript();
+// ?face=<name> preloads faces/<name>.js and puts its prebuilt faces/<name>.min.js in the
+// minified tab as-is: the in-page minifier never renames, so regenerating it would undo the build.
+function loadFaceScript(face) {
+  const fetchText = (path) => fetch(path).then((res) => {
+    if (!res.ok) throw new Error(`HTTP ${res.status}`);
+    return res.text();
+  });
+  return Promise.all([fetchText(`faces/${face}.js`), fetchText(`faces/${face}.min.js`)])
+    .then(([source, built]) => {
+      loadEditorScript(source, `${face}.js`);
+      editorMinified.value = built;
+      minifiedSourceSnapshot = source;
+    })
+    .catch((e) => {
+      logError(`Couldn't load face "${face}": ${e.message}`);
+      return loadDefaultExampleScript();
+    });
+}
+const faceParam = new URLSearchParams(location.search).get('face');
+const defaultExampleReady = faceParam && /^[\w-]+$/.test(faceParam)
+  ? loadFaceScript(faceParam)
+  : loadDefaultExampleScript();
 
 // Puts a script in the editor as if it had been loaded from a file.
 function loadEditorScript(text, fileName) {
-- 
